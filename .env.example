# Select one database provider per deployment: mongodb (default) or postgres.
DB_PROVIDER=mongodb

# Optional PostgreSQL provider. Use DATABASE_URL or the PG* variables below if selecting postgres.
DATABASE_URL=postgresql://turfyslot_user:replace-me@localhost:5432/turfyslot
PGSSLMODE=disable
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=turfyslot
# PGUSER=turfyslot_user
# PGPASSWORD=replace-me

# MongoDB Atlas provider. Set a real MONGODB_URI in your local environment; never commit credentials.
# Do not commit real database credentials.
MONGODB_URI=mongodb+srv://replace-user:replace-password@replace-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=turfyslot

# Required application secrets: generate independent, random values for each environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# 32 random bytes encoded as base64 or 64 hexadecimal characters; keep it separate from the database backup.
PAYOUT_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-or-64-char-hex-key

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
PUBLIC_UPLOADS_DIR=uploads/public

# Public Mapbox token used by the browser map (restrict by allowed URLs in Mapbox settings).
VITE_MAPBOX_TOKEN=

# Generate a separate 32-byte key (base64 or 64-character hex) to encrypt the Admin-managed SSLCommerz Store Password.
SSLCOMMERZ_CONFIG_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-or-64-character-hex-key

# Generate independent 32-byte keys for ShurjoPay and UddoktaPay credentials.
SHURJOPAY_CONFIG_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-or-64-character-hex-key
UDDOKTAPAY_CONFIG_ENCRYPTION_KEY=replace-with-a-different-random-32-byte-base64-or-64-character-hex-key

# Optional VPS service URLs and server-side encryption keys. Set secrets in the deployment secret store.
REDIS_URL=redis://redis:6379
SMTP_CONFIG_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-or-64-character-hex-key
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=replace-with-a-different-random-32-byte-base64-or-64-character-hex-key
VAPID_PUBLIC_KEY=replace-with-generated-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-generated-private-vapid-key
VAPID_SUBJECT=mailto:admin@example.com
SMS_API_KEY=replace-with-bulk-sms-bd-api-key
SMS_SENDER_ID=replace-with-approved-sender-id
SMS_API_URL=https://api.bulksmsbd.co/send

# Run npm run db:seed-admin once to create the first admin account.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Generate an independent 32-byte key for encrypted SMTP passwords.
