{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node server.js",
    "start": "node server.js",
    "db:migrate": "node database/applySchema.js",
    "db:migrate:mongodb-to-postgres": "node database/migrateMongoToPostgres.js --confirm",
    "db:import-role-backups": "node database/importRoleJsonBackups.js",
    "db:reset-admin-password": "node database/resetAdminPassword.js",
    "db:create-first-admin": "node database/createFirstAdmin.js",
    "db:seed-admin": "node database/seedAdmin.js",
    "test:provider": "node --test tests/database-provider.integration.test.js",
    "test:role-backup-restore": "node --test tests/role-backup-restore.test.js",
    "test:admin-password-reset": "node --test tests/admin-password-reset.test.js",
    "test:first-admin-creation": "node --test tests/first-admin-creation.test.js",
    "test:mongo-connection": "node --test tests/mongo-connection.test.js",
    "dev:all": "concurrently -n web,api -c cyan,yellow \"npm:dev\" \"npm:server\"",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "clean": "node --input-type=commonjs -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "bullmq": "^6.3.8",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.32.0",
    "mongodb": "^6.21.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
